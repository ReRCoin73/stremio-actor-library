# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo .env pro GitHub.

# Pegue rodando: node lib/getAuthKey.js seu-email suaSenha
STREMIO_AUTH_KEY=

# Crie gratis em https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Porta do servidor (o Render define isso sozinho, pode deixar)
PORT=7000
